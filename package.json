{
  "name": "kumohiro-daka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"node --watch server/src/index.js\" \"vite --config client/vite.config.ts --host 127.0.0.1\"",
    "dev:api": "node --watch server/src/index.js",
    "dev:web": "vite --config client/vite.config.ts --host 127.0.0.1",
    "build": "vite build --config client/vite.config.ts",
    "typecheck": "tsc -p client/tsconfig.json --noEmit",
    "start": "node server/src/index.js",
    "test": "node --test server/test/*.test.js",
    "check": "npm run test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "overrides": {
    "archiver": "^8.0.0",
    "unzipper": "^0.12.5",
    "uuid": "^11.1.0"
  }
}

# 将此 server 块放入 Windows Nginx 的 http 配置中。
# Windows 路径请使用正斜杠；证书路径按服务器实际情况修改。

server {
    listen 80;
    server_name daka.kumohiro.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name daka.kumohiro.com;

    ssl_certificate      D:/nginx/conf/ssl/daka.kumohiro.com/fullchain.pem;
    ssl_certificate_key  D:/nginx/conf/ssl/daka.kumohiro.com/privkey.pem;

    root D:/www/daka/client/dist;
    index index.html;
    client_max_body_size 10m;

    location /api/ {
        proxy_pass http://127.0.0.1:3101;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
